# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
GE1_01/SourceArt/**/*.png
GE1_01/SourceArt/**/*.tga

# Binary Files
GE1_01/Binaries/*
GE1_01/Plugins/**/Binaries/*

# Builds
GE1_01/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!GE1_01/Build/*/
GE1_01/Build/*/**
!GE1_01/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!GE1_01/Build/**/*.ico

# Built data for maps
GE1_01/*_BuiltData.uasset

# Configuration files generated by the Editor
GE1_01/Saved/*

# Compiled source files for the engine to use
GE1_01/Intermediate/*
GE1_01/Plugins/**/Intermediate/*

# Cache files for the editor to use
GE1_01/DerivedDataCache/*
